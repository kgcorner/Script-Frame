# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_PATH=./data/video-generator.db

# Omniroute Configuration (for LLM routing)
OMNIROUTE_BASE_URL=http://localhost:8000
OMNIROUTE_API_KEY=your_omniroute_api_key_here
OMNIROUTE_TIMEOUT=30000

# ComfyUI Configuration (for video generation workflows)
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_TIMEOUT=120000

# CORS Configuration
CORS_ORIGIN=http://localhost:4200

# Authentication Configuration
# REQUIRED in production (server refuses to start without it). A dev fallback is
# used when NODE_ENV != production and this is unset.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime: '30m' | '12h' | '7d' | plain seconds ('3600'). Default: 24h
JWT_EXPIRES_IN=24h
# bcrypt cost factor for password hashing. Default: 10
BCRYPT_ROUNDS=10
# Optional bootstrap admin: seeded on first boot when the users table is empty.
# Leave empty to rely on public registration (the first registrant becomes admin).
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=