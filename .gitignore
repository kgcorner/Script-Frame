# Monorepo .gitignore for video-generator
# Covers: backend/ (Node.js/Express) + scriptframe-studio/ (Angular)

### Dependencies ###
node_modules/
.pnp
.pnp.js

### Build Outputs ###
dist/
build/
*.tsbuildinfo

### Environment Files ###
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

### Backend Specific ###
backend/dist/
backend/node_modules/
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/assets/
backend/coverage/
backend/.env

### Frontend (scriptframe-studio) Specific ###
scriptframe-studio/dist/
scriptframe-studio/node_modules/
scriptframe-studio/.angular/
scriptframe-studio/coverage/
scriptframe-studio/.env
scriptframe-studio/*.tsbuildinfo

### IDE/Editor ###
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.idea/
*.swp
*.swo

### OS ###
.DS_Store
Thumbs.db

### Logs ###
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

### Test Coverage ###
coverage/
.nyc_output/

### Cache ###
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

### Misc ###
*.tgz
.yarn-integrity
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
